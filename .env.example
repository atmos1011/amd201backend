# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Neon connection string for PollService and VotingService. Both the URI form shown
# below and the .NET key/value form are accepted. Leave it unset to use the local
# postgres container from docker-compose.yml instead.
POSTGRES_CONNECTION=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
