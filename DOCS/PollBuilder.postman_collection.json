{
  "info": {
    "name": "Poll & Survey Builder API",
    "description": "Every request goes through the API gateway on {{gateway}}, which is what the Vue app uses too, so this tests the real path across all three services.\n\nRun the four projects first (PollManage, VoteManage, ResultManage, ApiGateway), then either send requests one at a time from the top, or use the Collection Runner to run all 17 in order.\n\nRequest 1 saves the poll code and creator token automatically, so there is nothing to copy by hand.\n\nTo test the deployed API instead, change the `gateway` variable to your Render gateway URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:5000",
      "description": "Change to the Render gateway URL to test the deployed API"
    },
    {
      "key": "code",
      "value": "",
      "description": "filled in by request 1"
    },
    {
      "key": "creatorToken",
      "value": "",
      "description": "filled in by request 1"
    }
  ],
  "item": [
    {
      "name": "1. Create a poll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Tabs or spaces?\",\n  \"options\": [\n    \"Tabs\",\n    \"Spaces\",\n    \"I do not care\"\n  ]\n}"
        },
        "description": "Creates the poll. The test script saves the code and creator token into collection variables, so every request after this one just works."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var body = pm.response.json();",
              "pm.collectionVariables.set(\"code\", body.code);",
              "pm.collectionVariables.set(\"creatorToken\", body.creatorToken);",
              "pm.test(\"returns a creator token once\", function () {",
              "    pm.expect(body.creatorToken).to.be.a(\"string\").and.not.empty;",
              "});",
              "console.log(\"poll code: \" + body.code);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Read the poll",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}"
          ]
        },
        "description": "Served by PollManage (service A)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"has 3 options\", function () {",
              "    pm.expect(pm.response.json().options).to.have.lengthOf(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Vote as browser A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Voter-Token",
            "value": "browser-a"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"optionIndex\": 0\n}"
        },
        "description": "X-Voter-Token is how the server tells browsers apart. No login needed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Vote again as browser A (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Voter-Token",
            "value": "browser-a"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"optionIndex\": 1\n}"
        },
        "description": "One vote per person. Stays 409 however many times you send it."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Vote as browser B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Voter-Token",
            "value": "browser-b"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"optionIndex\": 1\n}"
        },
        "description": "A different token is a different person, so this is allowed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Vote for an option that does not exist (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Voter-Token",
            "value": "browser-c"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"optionIndex\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Live results",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/results",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "results"
          ]
        },
        "description": "Served by ResultManage (service C): it asked PollManage for the option text and VoteManage for the counts, then joined them."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var body = pm.response.json();",
              "pm.test(\"2 votes counted\", function () {",
              "    pm.expect(body.totalVotes).to.eql(2);",
              "});",
              "pm.test(\"options carry text from PollManage\", function () {",
              "    pm.expect(body.options[0].text).to.eql(\"Tabs\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Raw counts owned by VoteManage",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote/counts",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote",
            "counts"
          ]
        },
        "description": "Numbers only, no option text, because VoteManage does not have the Polls table. Compare with request 7 to see what each service owns."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Has this browser voted?",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Voter-Token",
            "value": "browser-a"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote/me",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"browser-a has voted\", function () {",
              "    pm.expect(pm.response.json().hasVoted).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Download results as CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/results.csv",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "results.csv"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Edit after voting started (409)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Creator-Token",
            "value": "{{creatorToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"A completely different question?\"\n}"
        },
        "description": "The question is frozen once the first vote lands, otherwise those votes would silently move onto different text."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Close without the creator token (403)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/close",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "close"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Close the poll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Creator-Token",
            "value": "{{creatorToken}}"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/close",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "close"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"status is now Closed\", function () {",
              "    pm.expect(pm.response.json().status).to.eql(\"Closed\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Vote after closing (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Voter-Token",
            "value": "browser-d"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}/vote",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}",
            "vote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"optionIndex\": 0\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Reopen the poll",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Creator-Token",
            "value": "{{creatorToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Open\"\n}"
        },
        "description": "PATCH only changes what you send, so this touches the status and nothing else."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Unknown poll code (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/zzzzzz",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "zzzzzz"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Replace the whole poll with PUT (409)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Creator-Token",
            "value": "{{creatorToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/polls/{{code}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "polls",
            "{{code}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Which editor?\",\n  \"options\": [\n    \"Visual Studio\",\n    \"VS Code\"\n  ]\n}"
        },
        "description": "PUT needs every field, unlike PATCH. Still 409 here because the poll has votes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
