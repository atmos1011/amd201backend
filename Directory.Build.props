<Project>

  <!-- Applied to every project in the solution so build settings and static analysis stay
       consistent across all four services. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The "linting or static analysis" requirement in the brief. The same analyzers run in the
         IDE and in the CI pipeline, so CI cannot fail on something invisible locally. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Deliberately disabled:
         CS1591 - XML doc comments are not required on every public member.
         CA1848/CA1873 - LoggerMessage source generators trade readability for throughput we do not
                         need at this scale; plain ILogger calls are clearer in a teaching codebase.
         CA1716 - IPollCodeGenerator.Next() reads naturally in C#; the VB keyword clash is moot here. -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1873;CA1716</NoWarn>
  </PropertyGroup>

</Project>
